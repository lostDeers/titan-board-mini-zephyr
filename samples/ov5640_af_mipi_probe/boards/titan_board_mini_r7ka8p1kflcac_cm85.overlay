#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/video/video-interfaces.h>

/ {
	/* GPT clocking in this board build produces an exact 25 MHz XCLK tick rate. */
	ov5640_xclk: ov5640-xclk {
		compatible = "pwm-clock";
		#clock-cells = <1>;
		pwms = <&pwm11 1 PWM_HZ(25000000) PWM_POLARITY_NORMAL>;
		clock-frequency = <25000000>;
		pwm-on-delay = <1000>;
		status = "okay";
	};
};

&pwm11 {
	pinctrl-0 = <&pwm11_camera_xclk_default>;
	pinctrl-names = "default";
	interrupts = <38 12>, <39 12>;
	interrupt-names = "gtioca", "overflow";
	status = "okay";
};

&iic0 {
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&iic0_camera_default>;
	pinctrl-names = "default";
	status = "okay";

	ov5640: ov5640@3c {
		compatible = "ovti,ov5640";
		reg = <0x3c>;

		port {
			ov5640_mipi_ep_out: endpoint {
				remote-endpoint-label = "titan_mipi_csi2_ep_in";
				bus-type = <VIDEO_BUS_TYPE_CSI2_DPHY>;
				data-lanes = <1 2>;
			};
		};
	};
};
