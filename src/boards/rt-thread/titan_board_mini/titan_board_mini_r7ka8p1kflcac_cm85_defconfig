# Enable GPIO
CONFIG_GPIO=y

# Enable Console
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y

# Enable I2C
CONFIG_I2C=y

# Enable SPI
CONFIG_SPI=y

# Enable RTC
CONFIG_RTC=y

# Enable Watchdog
CONFIG_WATCHDOG=y

# Enable Ethernet networking
CONFIG_NETWORKING=y

# Enable SDHC
CONFIG_SDHC=y

# Enable USB device
CONFIG_USB_DEVICE_STACK=y

# Enable Input (buttons)
CONFIG_INPUT=y

# Enable HW Info
CONFIG_HWINFO=y
